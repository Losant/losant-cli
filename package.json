{
  "name": "losant-cli",
  "version": "2.0.0",
  "description": "Losant Command Line Interface",
  "license": "MIT",
  "homepage": "https://github.com/Losant/losant-cli#readme",
  "author": "Losant <hello@losant.com>",
  "bugs": {
    "url": "https://github.com/Losant/losant-cli/issues"
  },
  "keywords": [
    "IoT",
    "platform",
    "CLI"
  ],
  "bin": {
    "losant": "./bin/losant.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "precommit": "lint-staged",
    "test": "FORCE_COLOR=1 mocha test",
    "reinstall": "rm -rf nodes_modules && pnpm install",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/losant-cli.git"
  },
  "dependencies": {
    "@rjhilgefort/export-dir": "^2.0.0",
    "axios": "^1.5.1",
    "chalk": "^4.1.1",
    "chokidar": "^3.5.3",
    "cli-table3": "^0.6.0",
    "commander": "^10.0.1",
    "csv-stringify": "^6.4.4",
    "death": "^1.1.0",
    "error": "^7.2.0",
    "find-file-up": "^2.0.1",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "glob": "^10.5.0",
    "inquirer": "^14.0.2",
    "js-yaml": "^3.14.1",
    "jsonwebtoken": "^9.0.3",
    "losant-rest": "^3.0.0",
    "mime-types": "^2.1.30",
    "minimatch": "^9.0.3",
    "moment": "^2.29.1",
    "omnibelt": "^3.1.2",
    "proper-lockfile": "^4.1.2",
    "rollbar": "^2.26.2",
    "sanitize-filename": "^1.6.2",
    "single-line-log": "^1.1.2",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.1.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "nock": "^13.3.6",
    "should": "^13.2.3",
    "sinon": "^22.1.0"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "files": [
    "bin/*",
    "lib/*",
    "commands/*",
    "README.md"
  ],
  "mocha": {
    "reporter": "spec",
    "recursive": true,
    "require": "should",
    "check-leaks": true
  },
  "packageManager": "pnpm@11.21.0"
}
